# Supabase > Connect. Khóa anon/publishable dùng cho trình duyệt.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chỉ dùng trên máy chủ.
SUPABASE_SERVICE_ROLE_KEY=
LLM_BASE_URL=http://localhost:20128/v1
LLM_API_KEY=
# Tên combo hoặc model đúng như dashboard 9Router. Tách các lựa chọn bằng dấu phẩy.
MODEL_FAST=lingua-fast
MODEL_SMART=lingua-smart,lingua-fast
MODEL_VISION=lingua-vision
# Chỉ cần cho npm run seed. Dùng tài khoản giáo viên đã xác nhận email.
SEED_TEACHER_EMAIL=
SEED_TEACHER_PASSWORD=
