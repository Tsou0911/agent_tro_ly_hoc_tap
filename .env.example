APP_ENV=development
POSTGRES_USER=app
POSTGRES_PASSWORD=change_me
POSTGRES_DB=learning
POSTGRES_PORT=5432
DATABASE_URL=postgresql+pg8000://app:change_me@127.0.0.1:5432/learning

# Use a Gemini API key from a Free Tier project.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
LLM_TIMEOUT_SECONDS=45
MAX_REGENERATIONS=2
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=course_chunks
EMBEDDING_MODEL=intfloat/multilingual-e5-small
RETRIEVAL_LIMIT=6
RETRIEVAL_SCORE_THRESHOLD=0.65
# Local JWT signing secret, not an external API key; use 32+ random characters.
JWT_SECRET=
